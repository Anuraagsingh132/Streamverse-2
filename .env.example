# ==========================================
# Streamverse 2 - Environment Variables
# ==========================================

# (Optional) TMDB API Key:
# If left blank or unset, Streamverse 2 automatically falls back to its built-in key.
# Get your personal free API key at: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=

# PostHog Product Analytics & Session Replay:
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
